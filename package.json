{
  "name": "characterization-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts --production",
    "demo": "node demo/server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.325",
    "@github/copilot": "1.0.112",
    "@github/copilot-sdk": "^1.0.34",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/codex": "0.169.0",
    "@playwright/mcp": "0.0.85",
    "@playwright/test": "1.65.1",
    "@xyflow/react": "12.12.1",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
